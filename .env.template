# Yahoo Developer App credentials
# Get these from: https://developer.yahoo.com/apps/
# Set your Redirect URI to: https://localhost:8080
YAHOO_CLIENT_ID=your_client_id_here
YAHOO_CLIENT_SECRET=your_client_secret_here

# Google AI API Key (for Gemini)
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Sleeper (fantasy football) — no API key or OAuth; the username is only used
# to find your leagues. Leave blank if you only use the NBA features.
SLEEPER_USERNAME=your_sleeper_username

# Fantasy Premier League — no API key or OAuth. FPL has no public username
# lookup, so this is the entry id: the number in the URL of your own points
# page, https://fantasy.premierleague.com/entry/<THIS>/event/1
FPL_ENTRY_ID=your_fpl_entry_id

# Optional Settings — all validated at startup by config/settings.py
YAHOO_MAX_WEEKLY_ADDS=3       # Max player adds per week (int >= 0, default: 3)
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
# NBA_API_DELAY=4.0           # Seconds between nba_api calls (float >= 0, default: 4.0)
# NBA_CACHE_FILE=.nba_cache.json
